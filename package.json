{
  "name": "jev-connect-four",
  "version": "1.0.0",
  "private": true,
  "description": "Vanilla Connect Four with JEV, Discord, authoritative replay and research analytics",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "node -e \"process.exit(0)\"",
    "start": "node --env-file-if-exists=.env scripts/dev.mjs",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test tests/*.test.js",
    "test:browser": "node --test tests/browser.test.mjs",
    "bench": "node --env-file-if-exists=.env bench/run.mjs",
    "audit": "node scripts/audit.mjs",
    "report": "node scripts/report.mjs",
    "discord:register": "node --env-file-if-exists=.env scripts/register-discord.mjs",
    "deploy": "wrangler deploy",
    "db:remote": "wrangler d1 migrations apply jev-connect-four --remote",
    "db:local": "wrangler d1 migrations apply jev-connect-four --local"
  },
  "devDependencies": {
    "wrangler": "4.35.0",
    "playwright": "1.55.1"
  }
}
