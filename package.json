{
  "name": "jev-choice-four",
  "version": "1.0.0",
  "private": true,
  "description": "Choice Four, human vs Jev: vanilla four-in-a-row with Discord, authoritative replay and research analytics",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "node -e \"process.exit(0)\"",
    "start": "node --env-file-if-exists=.env scripts/dev.mjs",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test tests/*.test.js",
    "test:browser": "node --test tests/browser.test.mjs",
    "bench": "node --env-file-if-exists=.env bench/run.mjs",
    "audit": "node scripts/audit.mjs",
    "report": "node scripts/report.mjs",
    "discord:register": "node --env-file-if-exists=.env scripts/register-discord.mjs",
    "deploy": "wrangler deploy",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "db:local": "wrangler d1 migrations apply DB --local",
    "deploy:godaddy": "node --env-file-if-exists=.env scripts/godaddy-deploy.js"
  },
  "devDependencies": {
    "wrangler": "4.35.0",
    "playwright": "1.55.1"
  }
}
